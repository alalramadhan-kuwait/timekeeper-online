{
  "name": "timekeeper-online",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run shared:check && npm run release:check && npm test && tsc && vite build && npm run sw:check",
    "shared:check": "node scripts/shared-check.mjs",
    "shared:hash": "node scripts/shared-check.mjs --write",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "echo 'Deploys are automatic: push to main and GitHub Actions builds and publishes it. Deploying from a laptop once overwrote the live site with an older build, so this is disabled on purpose.' && exit 1",
    "test": "tsx src/shared/__tests__/run.ts",
    "sw:check": "node scripts/sw-check.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "motion": "^13.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.1.4"
  }
}
